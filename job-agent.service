[Unit]
Description=Job Search Agent - scrape, score, notify
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/thomas/Code/job-agent
ExecStart=/usr/bin/python3 -u main.py
Restart=on-failure
RestartSec=60
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
