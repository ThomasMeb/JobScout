# ===========================================
# JobScout SaaS Environment Variables
# Copy to .env.saas and fill in your values
# ===========================================

# Supabase (https://supabase.com/dashboard)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_JWT_SECRET=your_jwt_secret_here

# DeepSeek LLM
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Scraper API keys
ADZUNA_APP_ID=your_adzuna_app_id_here
ADZUNA_APP_KEY=your_adzuna_app_key_here
FRANCE_TRAVAIL_CLIENT_ID=your_client_id_here
FRANCE_TRAVAIL_CLIENT_SECRET=your_client_secret_here

# Email notifications (https://resend.com)
RESEND_API_KEY=your_resend_api_key_here

# Telegram bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Notion (Phase 2 — optional)
NOTION_TOKEN=your_notion_integration_token_here
NOTION_JOBS_DB_ID=your_notion_jobs_database_id_here
NOTION_COMPANIES_DB_ID=your_notion_companies_database_id_here

# App
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000
