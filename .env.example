# DeepSeek API
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# OpenAI API (optional — only if using gpt-4o, gpt-4.1, etc.)
# OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API (optional — only if using claude-* models)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Adzuna API (https://developer.adzuna.com)
ADZUNA_APP_ID=your_adzuna_app_id_here
ADZUNA_APP_KEY=your_adzuna_app_key_here

# France Travail API (https://francetravail.io/data/api)
FRANCE_TRAVAIL_CLIENT_ID=your_client_id_here
FRANCE_TRAVAIL_CLIENT_SECRET=your_client_secret_here

# Notion API (https://www.notion.so/my-integrations)
NOTION_TOKEN=your_notion_token_here
NOTION_DATABASE_ID=your_jobs_database_id_here
NOTION_COMPANIES_DB_ID=your_companies_database_id_here
